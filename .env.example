# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Discord bot token (Developer Portal → Bot → Reset Token)
STRIFE_DISCORD_TOKEN=MTUxNjk5MDA0MDIzNTA1MzExNg.GQIIB5.2lPiao_MjrlF2axhBKWmQA6bPMkt4RiyE5bDkw

# PostgreSQL connection string
# Local (bot on host, Postgres on localhost):
STRIFE_DATABASE_URL=postgresql://strife:strife@localhost:5432/strife
# Docker Compose overrides this for the bot container (host `db`, not `localhost`).

# Comma-separated Discord user IDs allowed to run strife/* admin commands
STRIFE_OWNER_IDS=897146430664355850

# Logging: DEBUG, INFO, WARNING, ERROR
STRIFE_LOG_LEVEL=INFO

# Optional — defaults shown (usually leave unset)
# STRIFE_CONFIG_DIR=config
# STRIFE_MIGRATIONS_DIR=migrations
